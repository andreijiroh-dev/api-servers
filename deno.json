{
  "name": "@andreijiroh-dev/api-servers",
  "workspace": [
    "apps/website-api",
    "packages/lib"
  ],
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono",
    "hono": "jsr:@hono/hono",
    "chanfana": "npm:chanfana",
    "zod": "npm:zod",
    "@std/uuid": "jsr:@std/uuid",
    "node-appwrite": "npm:node-appwrite"
  },
  "unstable": ["kv", "cron"],
  "nodeModulesDir": "auto",
  "allowScripts": ["npm:@prisma/client@5.22.0", "npm:@prisma/engines@5.22.0", "npm:esbuild@0.17.19", "npm:prisma@5.22.0", "npm:workerd@1.20241106.1"]
}
