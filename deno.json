{
  "name": "@andreijiroh-dev/api-servers",
  "exports": {},
  "workspace": [
    "apps/website-api",
    "packages/lib"
  ],
  "tasks": {
    "dotenvx": "deno run -A @dotenvx/dotenvx",
    "utils:dotenvx": "deno run -A @dotenvx/dotenvx",
    "dotenvx:run": "deno task dotenvx run",
    "dotenvx:set": "deno task dotenvx set",
    "dotenvx:get": "deno task dotenvx get",
    "dotenvx:del": "deno task dotenvx del"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "imports": {
    "node-appwrite": "npm:node-appwrite",
    "@dotenvx/dotenvx": "npm:@dotenvx/dotenvx"
  },
  "unstable": ["kv", "cron"],
  "nodeModulesDir": "auto",
  "allowScripts": ["npm:@prisma/client@5.22.0", "npm:@prisma/engines@5.22.0", "npm:esbuild@0.17.19", "npm:prisma@5.22.0", "npm:workerd@1.20241106.1"]
}
